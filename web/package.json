{
  "name": "teachyaed-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TeachyaED React/TypeScript foundation. Built alongside the legacy index.html per docs/REACT_MIGRATION_PLAN.md. Not the production entrypoint yet — see docs/SIDE_BY_SIDE.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
